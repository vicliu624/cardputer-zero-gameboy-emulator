[Desktop Entry]
Type=Application
Name=GBA Emulator
Comment=Game Boy Advance emulator for TDVP K230
Exec=/usr/bin/cardputer-zero-gba
# The TDVP firmware's hicolor cache belongs to the base image and is not
# regenerated by feed packages. Use this package-owned absolute path so
# wf-panel-pi loads the application icon directly.
Icon=/usr/share/icons/hicolor/128x128/apps/cardputer-zero-gba.png
Terminal=false
Categories=Game;Emulator;
StartupNotify=false
