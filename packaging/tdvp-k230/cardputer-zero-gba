#!/bin/sh
set -eu

runtime_dir=/opt/tdvp-cardputer-zero-gba
runtime="$runtime_dir/cardputer-zero-gba"

if [ ! -x "$runtime" ]; then
    echo "cardputer-zero-gba: missing TDVP K230 runtime: $runtime" >&2
    exit 127
fi

# The TDVP desktop runs labwc, which owns DRM master. This application is a
# Wayland client: labwc continues to own the DRM/KMS CRTC and panel transform.
# That is still the device's DRM path, but does not let an app modeset global
# display state. Do not select fbdev or KMSDRM here.
export SDL_VIDEODRIVER=wayland
if [ -n "${HOME:-}" ] && [ -d "$HOME" ]; then
    cd -- "$HOME"
fi
exec "$runtime" --device-profile tdvp-k230 "$@"
